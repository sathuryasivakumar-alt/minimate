<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ShopEase - Online Shopping</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, sans-serif;
}

body {
    background: #f5f5f5;
}

/* Header */
header {
    background: #172337;
    color: white;
    padding: 18px 5%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 15px;
}

.logo {
    font-size: 27px;
    font-weight: bold;
    color: #ffcc00;
}

.search-box {
    display: flex;
    gap: 5px;
}

.search-box input {
    padding: 10px;
    width: 250px;
    border: none;
    border-radius: 5px;
}

button {
    cursor: pointer;
    border: none;
    border-radius: 5px;
    padding: 10px 15px;
}

.search-box button {
    background: #ffcc00;
}

.cart {
    font-size: 18px;
}

/* Navigation */
nav {
    background: #2874f0;
    padding: 14px;
    text-align: center;
}

nav a {
    color: white;
    text-decoration: none;
    margin: 0 18px;
    font-weight: bold;
}

/* Banner */
.banner {
    background: linear-gradient(120deg, #2874f0, #6dd5ed);
    color: white;
    text-align: center;
    padding: 65px 15px;
}

.banner h1 {
    font-size: 38px;
    margin-bottom: 15px;
}

.banner p {
    font-size: 18px;
}

/* Products */
.container {
    padding: 35px 5%;
}

.container h2 {
    margin-bottom: 25px;
    text-align: center;
}

.products {
    display: grid;
    grid-template-columns:
    repeat(auto-fit, minmax(220px, 1fr));
    gap: 25px;
}

.product {
    background: white;
    border-radius: 10px;
    padding: 18px;
    text-align: center;
    box-shadow: 0 3px 10px #ddd;
    transition: 0.3s;
}

.product:hover {
    transform: translateY(-5px);
}

.product img {
    width: 100%;
    height: 170px;
    object-fit: contain;
    margin-bottom: 12px;
}

.product h3 {
    margin: 10px 0;
}

.price {
    color: #2874f0;
    font-size: 20px;
    font-weight: bold;
    margin: 12px;
}

.product button {
    background: #ffcc00;
    width: 100%;
    font-weight: bold;
}

/* Cart */
#cart-section {
    background: white;
    margin: 25px 5%;
    padding: 25px;
    border-radius: 10px;
}

#cart-items {
    margin: 15px 0;
}

.cart-item {
    display: flex;
    justify-content: space-between;
    padding: 12px 0;
    border-bottom: 1px solid #ddd;
    gap: 10px;
}

.remove {
    background: #e53935;
    color: white;
}

.checkout {
    background: #2874f0;
    color: white;
    margin-top: 15px;
    width: 100%;
    font-size: 16px;
}

/* Footer */
footer {
    background: #172337;
    color: white;
    text-align: center;
    padding: 25px;
    margin-top: 30px;
}

@media(max-width:600px) {
    header {
        justify-content: center;
    }

    .search-box input {
        width: 180px;
    }

    nav a {
        display: inline-block;
        margin: 7px;
    }

    .banner h1 {
        font-size: 28px;
    }
}
</style>
</head>

<body>

<header>
    <div class="logo">ShopEase</div>

    <div class="search-box">
        <input type="text" id="search"
        placeholder="Search products..."
        oninput="searchProducts()">
        <button onclick="searchProducts()">Search</button>
    </div>

    <div class="cart">
        🛒 Cart (<span id="cart-count">0</span>)
    </div>
</header>

<nav>
    <a href="#">Home</a>
    <a href="#products">Products</a>
    <a href="#cart-section">My Cart</a>
    <a href="#footer">Contact</a>
</nav>

<section class="banner">
    <h1>Welcome to ShopEase!</h1>
    <p>Discover Amazing Products at Amazing Prices.</p>
</section>

<section class="container" id="products">
    <h2>Our Products</h2>

    <div class="products" id="product-list"></div>
</section>

<section id="cart-section">
    <h2>🛒 Shopping Cart</h2>

    <div id="cart-items">
        Your cart is empty.
    </div>

    <h3>Total: ₹<span id="total">0</span></h3>

    <button class="checkout" onclick="checkout()">
        Proceed to Checkout
    </button>
</section>

<footer id="footer">
    <p>© 2026 ShopEase. All Rights Reserved.</p>
    <p>Email: support@shopease.com</p>
</footer>

<script>

// Product details
const products = [
    {
        name: "Wireless Headphones",
        price: 1499,
        image: "https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=400"
    },
    {
        name: "Smart Watch",
        price: 2499,
        image: "https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=400"
    },
    {
        name: "Running Shoes",
        price: 1999,
        image: "https://images.unsplash.com/photo-1542291026-7eec264c27ff?w=400"
    },
    {
        name: "Laptop",
        price: 45999,
        image: "https://images.unsplash.com/photo-1496181133206-80ce9b88a853?w=400"
    },
    {
        name: "Camera",
        price: 32999,
        image: "https://images.unsplash.com/photo-1516035069371-29a1b244cc32?w=400"
    },
    {
        name: "Backpack",
        price: 999,
        image: "https://images.unsplash.com/photo-1553062407-98eeb64c6a62?w=400"
    }
];

let cart = [];

// Display products
function displayProducts(items) {
    const list = document.getElementById("product-list");
    list.innerHTML = "";

    items.forEach((product) => {
        list.innerHTML += `
        <div class="product">
            <img src="${product.image}" alt="${product.name}">
            <h3>${product.name}</h3>
            <p class="price">₹${product.price.toLocaleString("en-IN")}</p>
            <button onclick="addToCart('${product.name}')">
                Add to Cart
            </button>
        </div>`;
    });
}

// Search products
function searchProducts() {
    const value = document.getElementById("search")
        .value.toLowerCase();

    const filtered = products.filter(product =>
        product.name.toLowerCase().includes(value)
    );

    displayProducts(filtered);
}

// Add to cart
function addToCart(name) {
    const product = products.find(p => p.name === name);
    const existing = cart.find(p => p.name === name);

    if (existing) {
        existing.quantity++;
    } else {
        cart.push({...product, quantity: 1});
    }

    updateCart();
}

// Update cart
function updateCart() {
    const items = document.getElementById("cart-items");
    const count = document.getElementById("cart-count");
    const totalElement = document.getElementById("total");

    items.innerHTML = "";
    let total = 0;
    let quantity = 0;

    if (cart.length === 0) {
        items.innerHTML = "Your cart is empty.";
    }

    cart.forEach((product, index) => {
        total += product.price * product.quantity;
        quantity += product.quantity;

        items.innerHTML += `
        <div class="cart-item">
            <span>
                ${product.name} - ₹${product.price}
                × ${product.quantity}
            </span>
            <button class="remove"
            onclick="removeItem(${index})">
                Remove
            </button>
        </div>`;
    });

    count.innerText = quantity;
    totalElement.innerText = total.toLocaleString("en-IN");
}

// Remove product
function removeItem(index) {
    cart.splice(index, 1);
    updateCart();
}

// Checkout
function checkout() {
    if (cart.length === 0) {
        alert("Your cart is empty!");
        return;
    }

    alert("Thank you for shopping with ShopEase! " +
          "Your order total is ₹" +
          cart.reduce((sum, p) =>
          sum + p.price * p.quantity, 0));

    cart = [];
    updateCart();
}

// Initial display
displayProducts(products);
updateCart();

</script>

</body>
</html>